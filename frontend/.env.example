# Backend API URL for Vercel / Production Deployment
# Set this in your Vercel Project Settings > Environment Variables:
# Example for deployed backend on Render / Railway / Fly.io:
# NEXT_PUBLIC_API_URL=https://your-backend-api.onrender.com
#
# For local development (default if omitted):
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

