# Django Settings
SECRET_KEY=django-insecure-ai-resume-generator-secret-key-change-in-production-2026
DEBUG=True
ALLOWED_HOSTS=*

# CORS Settings (Restricted strictly to Localhost and Vercel deployments)
# CORS_ALLOW_ALL_ORIGINS is False by default so arbitrary origins are blocked
CORS_ALLOW_ALL_ORIGINS=False
# Optional explicit frontend URL or custom domain (e.g. from Vercel)
# FRONTEND_URL=https://your-custom-domain.vercel.app
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Note: All *.vercel.app subdomains and localhost ports are automatically allowed via regex!
CSRF_TRUSTED_ORIGINS=https://*.vercel.app,http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (PostgreSQL default, SQLite fallback supported)
USE_SQLITE=True
DATABASE_URL=postgres://resume_user:resume_password@localhost:5432/resume_gen_db

# LLM Provider Configuration (Strictly backend)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_RETRIES=3
GEMINI_TIMEOUT_SECONDS=60
