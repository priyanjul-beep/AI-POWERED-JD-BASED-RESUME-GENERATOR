# Django Settings
SECRET_KEY=django-insecure-ai-resume-generator-secret-key-change-in-production-2026
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS Settings for Next.js frontend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (PostgreSQL default, SQLite fallback supported)
USE_SQLITE=True
DATABASE_URL=postgres://resume_user:resume_password@localhost:5432/resume_gen_db

# LLM Provider Configuration (Strictly backend)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_RETRIES=3
GEMINI_TIMEOUT_SECONDS=60
